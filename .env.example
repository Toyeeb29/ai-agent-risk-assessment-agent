# ---------------------------------------------------------------------------
# Self-hosted n8n webhook that runs the AI Agent Risk Assessment workflow.
# This is the ONLY backend the frontend talks to. Never put API keys here:
# anything prefixed VITE_ is compiled into the browser bundle and is public.
# ---------------------------------------------------------------------------

# Production webhook (workflow must be Active in n8n)
VITE_N8N_AI_RISK_WEBHOOK=https://n8n.example.com/webhook/ai-risk-assessment

# Optional: n8n test URL used while building the workflow in the n8n editor
# VITE_N8N_AI_RISK_WEBHOOK=https://n8n.example.com/webhook-test/ai-risk-assessment

# Optional: request timeout in milliseconds (default 120000).
# The workflow runs 4-6 LLM calls, so allow generous headroom.
VITE_N8N_TIMEOUT_MS=120000
